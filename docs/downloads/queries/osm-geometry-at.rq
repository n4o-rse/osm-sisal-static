PREFIX ossp: <https://n4o-rse.github.io/osm-sisal-static/prop/>
PREFIX osspq: <https://n4o-rse.github.io/osm-sisal-static/prop/qualifier/>
PREFIX ossps: <https://n4o-rse.github.io/osm-sisal-static/prop/statement/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

#defaultView:Map
SELECT ?item ?label ?geometry ?since WHERE {
  ?item ossp:P111 ?entry ;
        rdfs:label ?label .
  ?entry ossps:P111 ?geometry ;
         osspq:P103 ?since .
  FILTER(LANG(?label) = "en")
  FILTER(?since <= "2023-01-01T00:00:00Z")
  FILTER NOT EXISTS {
    ?item ossp:P111 ?later .
    ?later osspq:P103 ?laterSince .
    FILTER(?laterSince > ?since && ?laterSince <= "2023-01-01T00:00:00Z")
  }
}
ORDER BY ?label ?item
LIMIT 200
